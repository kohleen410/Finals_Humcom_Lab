<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UB Campus Parking & Bike Rack Tracker - Wireframe Prototype</title>
    <style>
        :root {
            --bg-canvas: #ffffff;
            --wireframe-dark: #000000;
            --wireframe-light: #ffffff;
            --wireframe-gray: #555555;
        }


        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }


        body {
            background-color: var(--bg-canvas);
            color: var(--wireframe-dark);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 15px;
            font-size: 13px;
        }


        .prototype-header {
            text-align: center;
            margin-bottom: 15px;
        }


        .prototype-header h1 {
            font-size: 15px;
            color: var(--wireframe-dark);
        }


        .prototype-header p {
            font-size: 10px;
            color: var(--wireframe-gray);
            margin-top: 2px;
        }


        /* Side-by-Side Three Frame Wrapper */
        .side-by-side-wrapper {
            display: flex;
            gap: 20px;
            justify-content: center;
            align-items: flex-start;
            flex-wrap: wrap;
            width: 100%;
            max-width: 1200px;
        }


        .frame-column {
            display: flex;
            flex-direction: column;
            align-items: center;
        }


        .frame-label {
            font-size: 10px;
            font-weight: bold;
            color: var(--wireframe-dark);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }


        .app-container {
            width: 350px;
            height: 680px;
            background-color: var(--wireframe-light);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 0 0 2px var(--wireframe-dark);
            border-radius: 4px;
            position: relative;
        }


        .screen {
            display: flex;
            flex: 1;
            flex-direction: column;
            overflow: hidden;
        }


        /* 1. AUTH SCREEN */
        #screen-login {
            background-color: var(--wireframe-light);
            justify-content: center;
            align-items: center;
            padding: 16px;
            text-align: center;
            color: var(--wireframe-dark);
            overflow-y: auto;
        }


        .login-wrapper-direct {
            width: 100%;
            max-width: 300px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }


        .mode-buttons {
            display: flex;
            gap: 6px;
            width: 100%;
        }


        .mode-btn {
            flex: 1;
            background-color: var(--wireframe-light);
            border: 2px solid var(--wireframe-dark);
            color: var(--wireframe-dark);
            padding: 9px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 0;
            transition: 0s;
        }


        .mode-btn.active {
            background-color: var(--wireframe-dark);
            border-color: var(--wireframe-dark);
            color: var(--wireframe-light);
        }


        .auth-heading {
            font-size: 13px;
            letter-spacing: 0.5px;
            margin-top: 4px;
            font-weight: bold;
        }


        .auth-sub {
            font-size: 10px;
            color: var(--wireframe-gray);
            margin-bottom: 6px;
        }


        .input-group {
            text-align: left;
        }


        .input-group label {
            font-size: 10px;
            color: var(--wireframe-dark);
            display: block;
            margin-bottom: 2px;
            font-weight: bold;
        }


        .input-group input, .input-group select {
            width: 100%;
            padding: 8px;
            border-radius: 0;
            border: 2px solid var(--wireframe-dark);
            background-color: var(--wireframe-light);
            color: var(--wireframe-dark);
            font-size: 11px;
        }


        .password-container {
            display: flex;
            gap: 0;
            align-items: center;
        }


        .password-container input {
            flex: 1;
        }


        .toggle-pass-btn {
            background-color: var(--wireframe-light);
            border: 2px solid var(--wireframe-dark);
            border-left: none;
            color: var(--wireframe-dark);
            padding: 8px 10px;
            cursor: pointer;
            font-size: 12px;
        }


        .login-error {
            color: var(--wireframe-dark);
            border: 1px dashed var(--wireframe-dark);
            padding: 4px;
            font-size: 9.5px;
            margin-top: 2px;
            display: none;
        }


        .login-btn {
            width: 100%;
            padding: 10px;
            background-color: var(--wireframe-dark);
            color: var(--wireframe-light);
            border: 2px solid var(--wireframe-dark);
            font-weight: bold;
            font-size: 11px;
            cursor: pointer;
            margin-top: 6px;
        }


        /* 2. MAIN DASHBOARD */
        .app-header {
            background-color: var(--wireframe-light);
            border-bottom: 2px solid var(--wireframe-dark);
            padding: 8px 10px;
            text-align: center;
            color: var(--wireframe-dark);
            flex-shrink: 0;
        }


        .app-header h1 {
            font-size: 11px;
            letter-spacing: 0.5px;
            margin-bottom: 3px;
        }


        .overview-banner {
            background-color: var(--wireframe-light);
            color: var(--wireframe-dark);
            padding: 3px 8px;
            font-size: 9.5px;
            font-weight: bold;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border: 1px solid var(--wireframe-dark);
        }


        .badge-icon {
            background-color: var(--wireframe-dark);
            color: var(--wireframe-light);
            border-radius: 50%;
            width: 10px;
            height: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 7px;
        }


        .filter-bar {
            display: flex;
            justify-content: space-around;
            background-color: var(--wireframe-light);
            border-bottom: 2px solid var(--wireframe-dark);
            padding: 5px 8px;
            flex-shrink: 0;
        }


        .filter-btn {
            background: transparent;
            border: 1px solid transparent;
            color: var(--wireframe-dark);
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 8.5px;
            cursor: pointer;
            padding: 3px 6px;
        }


        .filter-btn.active {
            border: 1px solid var(--wireframe-dark);
            font-weight: bold;
        }


        .dashboard-content {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
            background-color: var(--wireframe-light);
        }


        .grid-layout {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 5px;
            margin-bottom: 8px;
        }


        .card {
            background-color: var(--wireframe-light);
            padding: 6px 4px;
            font-size: 9px;
            font-weight: 600;
            text-align: center;
            color: var(--wireframe-dark);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 48px;
            border: 1px solid var(--wireframe-dark);
            cursor: pointer;
        }


        .card.active-selected {
            border: 2px solid var(--wireframe-dark);
            outline: 1px dashed var(--wireframe-dark);
        }


        .status-pill {
            font-size: 7.5px;
            margin-top: 2px;
            font-weight: bold;
            border: 1px dotted var(--wireframe-dark);
            padding: 1px 3px;
        }


        .zone-status-container {
            background-color: var(--wireframe-light);
            padding: 6px 8px;
            border: 1px solid var(--wireframe-dark);
            margin-bottom: 6px;
        }


        .zone-status-container h3 {
            font-size: 10px;
            color: var(--wireframe-dark);
            margin-bottom: 3px;
            border-bottom: 1px solid var(--wireframe-dark);
            padding-bottom: 2px;
        }


        .zone-list {
            list-style: none;
        }


        .zone-list li {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            padding: 3px 0;
            border-bottom: 1px dotted var(--wireframe-dark);
            align-items: center;
        }


        .dot {
            height: 6px;
            width: 6px;
            border: 1px solid var(--wireframe-dark);
            display: inline-block;
            margin-left: 4px;
        }
        .dot.green { background-color: var(--wireframe-dark); }
        .dot.red { background-color: var(--wireframe-light); }


        .confirmation-box {
            background-color: var(--wireframe-light);
            padding: 6px 8px;
            font-size: 10px;
            color: var(--wireframe-dark);
            font-weight: bold;
            margin-top: 5px;
            border: 1px solid var(--wireframe-dark);
        }


        .confirmation-box input[type="date"], .confirmation-box select {
            width: 100%;
            padding: 4px;
            margin-top: 2px;
            margin-bottom: 4px;
            border: 1px solid var(--wireframe-dark);
            background: var(--wireframe-light);
            color: var(--wireframe-dark);
            font-size: 10px;
        }


        .reserve-action-btn {
            background-color: var(--wireframe-dark);
            color: var(--wireframe-light);
            border: 1px solid var(--wireframe-dark);
            padding: 6px;
            font-weight: bold;
            font-size: 10px;
            cursor: pointer;
            width: 100%;
        }


        .reservation-item {
            background: var(--wireframe-light);
            padding: 8px;
            border: 1px dashed var(--wireframe-dark);
            margin-top: 5px;
            text-align: left;
            font-size: 10px;
        }


        .bottom-nav {
            display: flex;
            justify-content: space-around;
            background-color: var(--wireframe-light);
            padding: 6px 0;
            flex-shrink: 0;
            border-top: 2px solid var(--wireframe-dark);
        }


        .nav-item {
            background: none;
            border: none;
            color: var(--wireframe-dark);
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 8.5px;
            cursor: pointer;
            flex: 1;
        }


        .nav-item.active {
            font-weight: bold;
            text-decoration: underline;
        }
    </style>
</head>
<body>


    <div class="prototype-header">
        <h1>UB Campus Parking & Bike Rack Tracker — Wireframe Prototype</h1>
        <p>[Monochrome Wireframe Layout with Success Reservation State]</p>
    </div>


    <div class="side-by-side-wrapper">


        <!-- FRAME 1: AUTHENTICATION SCREEN -->
        <div class="frame-column">
            <span class="frame-label">Frame 1: Auth Screen</span>
            <div class="app-container">
                <div id="screen-login" class="screen active">
                    <div class="login-wrapper-direct">
                        <div class="mode-buttons">
                            <button type="button" id="btn-mode-login" class="mode-btn active" onclick="setAuthMode('login')">Log In</button>
                            <button type="button" id="btn-mode-signup" class="mode-btn" onclick="setAuthMode('signup')">Sign Up</button>
                        </div>


                        <h2 class="auth-heading" id="auth-title">UB CAMPUS PARKER</h2>
                        <p class="auth-sub" id="auth-subtitle">Sign in with your University ID</p>


                        <div class="input-group">
                            <label id="id-label-text">Student/Faculty ID (Valid: 2020–2026)</label>
                            <input type="text" id="input-id" placeholder="e.g. 2026-XXXXX">
                        </div>
                        <div class="input-group">
                            <label>Password</label>
                            <div class="password-container">
                                <input type="password" id="input-pass" placeholder="Enter password">
                                <button type="button" class="toggle-pass-btn" onclick="togglePasswordVisibility()">👁️</button>
                            </div>
                        </div>
                        <div class="input-group">
                            <label>Select Vehicle Type</label>
                            <select id="input-vehicle">
                                <option value="car">Car</option>
                                <option value="motorcycle">Motorcycle</option>
                                <option value="bicycle">Bicycle</option>
                            </select>
                        </div>
                        <div id="login-error-msg" class="login-error">Invalid ID format or year! Must be between 2020 and 2026.</div>
                        
                        <button type="button" id="auth-action-btn" class="login-btn" onclick="handleAuth()">LOG IN</button>
                    </div>
                </div>
            </div>
        </div>


        <!-- FRAME 2: MAIN DASHBOARD -->
        <div class="frame-column">
            <span class="frame-label">Frame 2: Main Dashboard</span>
            <div class="app-container">
                <header class="app-header">
                    <h1>UB CAMPUS PARKING TRACKER</h1>
                    <div class="overview-banner">
                        <span class="badge-icon">✔</span> OVERVIEW: 78 Free Slots
                    </div>
                </header>


                <div class="filter-bar">
                    <button class="filter-btn">🏍️ MOTORCYCLE</button>
                    <button class="filter-btn active">🚗 CAR</button>
                    <button class="filter-btn">🚲 BICYCLE</button>
                </div>


                <div class="dashboard-content">
                    <div class="grid-layout">
                        <div class="card">UB Science Lab</div>
                        <div class="card">UB Library</div>
                        <div class="card">North Lot:<br><strong>21/40 Free</strong><span class="status-pill">Available</span></div>
                        <div class="card">Gate 1 Lot:<br><strong>12/50 Free</strong><span class="status-pill">Full</span></div>
                        <div class="card active-selected">Main Bldg. Lot:<br><strong>45/60 Free</strong><span class="status-pill">Available</span></div>
                        <div class="card">Bike Rack B1:<br><strong>0/15 Free</strong><span class="status-pill">Full</span></div>
                        <div class="card">UB Gym</div>
                        <div class="card">Bike Rack B2:<br><strong>5/15 Free</strong><span class="status-pill">Available</span></div>
                        <div class="card">UB Main</div>
                    </div>


                    <div class="zone-status-container">
                        <h3>ZONE STATUS (CARS)</h3>
                        <ul class="zone-list">
                            <li><span>Main Bldg. Lot:</span> <strong>45 Spots <span class="dot green"></span></strong></li>
                            <li><span>North Lot:</span> <strong>21 Spots <span class="dot green"></span></strong></li>
                            <li><span>South Lot:</span> <strong>0 Spots <span class="dot red"></span></strong></li>
                        </ul>
                    </div>


                    <div class="confirmation-box">
                        [ Selected: Main Bldg. Lot ]
                        <div style="margin-top: 3px;">
                            <label style="font-size: 9px;">Reservation Date:</label>
                            <input type="date" value="2026-11-12">
                        </div>
                        <button class="reserve-action-btn">[ Confirm & Reserve Slot ]</button>
                    </div>
                </div>


                <nav class="bottom-nav">
                    <button class="nav-item active">🏠 HOME</button>
                    <button class="nav-item">🗺️ MAP</button>
                    <button class="nav-item">📋 RESERVATIONS</button>
                    <button class="nav-item">👤 PROFILE</button>
                </nav>
            </div>
        </div>


        <!-- FRAME 3: SUCCESSFUL RESERVATION STATE -->
        <div class="frame-column">
            <span class="frame-label">Frame 3: Reservation Successful</span>
            <div class="app-container">
                <header class="app-header">
                    <h1>UB CAMPUS PARKING TRACKER</h1>
                    <div class="overview-banner">
                        <span class="badge-icon">✔</span> RESERVATION TRACKER
                    </div>
                </header>


                <div class="dashboard-content">
                    <div style="text-align: center; margin-bottom: 10px; font-weight: bold;">
                        📋 Active Slot Reservations
                    </div>
                    
                    <div class="reservation-item">
                        [🚗] <strong>Main Bldg. Lot</strong><br>
                        Date: 2026-11-12 (Advance Reserve)<br>
                        Time: Morning (8:00 AM - 12:00 PM)<br>
                        <strong>Status: ✔ Confirmed & Tracked</strong>
                    </div>


                    <div style="margin-top: 15px; border: 1px solid var(--wireframe-dark); padding: 10px; text-align: center; font-size: 9.5px;">
                        <strong>Reservation QR Pass Generated</strong><br>
                        <span style="font-size: 24px;">⬛⬜⬛⬛⬜</span><br>
                        Scan at UB Gate Security
                    </div>
                </div>


                <nav class="bottom-nav">
                    <button class="nav-item">🏠 HOME</button>
                    <button class="nav-item">🗺️ MAP</button>
                    <button class="nav-item active">📋 RESERVATIONS</button>
                    <button class="nav-item">👤 PROFILE</button>
                </nav>
            </div>
        </div>


    </div>


    <script>
        function setAuthMode(mode) {
            const title = document.getElementById('auth-title');
            const subtitle = document.getElementById('auth-subtitle');
            const actionBtn = document.getElementById('auth-action-btn');
            const loginBtn = document.getElementById('btn-mode-login');
            const signupBtn = document.getElementById('btn-mode-signup');


            if (mode === 'signup') {
                loginBtn.classList.remove('active');
                signupBtn.classList.add('active');
                title.innerText = "CREATE NEW ACCOUNT";
                subtitle.innerText = "Register your University ID";
                actionBtn.innerText = "SIGN UP";
            } else {
                signupBtn.classList.remove('active');
                loginBtn.classList.add('active');
                title.innerText = "UB CAMPUS PARKER";
                subtitle.innerText = "Sign in with your University ID";
                actionBtn.innerText = "LOG IN";
            }
        }


        function togglePasswordVisibility() {
            const passInput = document.getElementById('input-pass');
            const toggleBtn = document.querySelector('.toggle-pass-btn');
            if (passInput.type === "password") {
                passInput.type = "text";
                toggleBtn.innerText = "🙈"; 
            } else {
                passInput.type = "password";
                toggleBtn.innerText = "👁️"; 
            }
        }
    </script>
</body>
</html>
